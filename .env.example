# Copy to .env and fill in. NEVER commit .env.
LLM_BASE_URL=https://your-gateway.example.com/v1
LLM_API_KEY=
CHAT_MODEL=
EXTRACT_MODEL=
EMBED_MODEL=
SCRAPER_USER_AGENT=CareerPathHackathonBot/0.1 (+contact: your-team@example.com)
# P2: 8 second shared JSON/repair budget; SDK retries disabled.
LLM_TIMEOUT_S=8
LLM_JSON_BUDGET_S=8
# Set false only if organiser gateway does not support JSON object mode.
LLM_JSON_MODE=true
# Enable only if configured model accepts temperature.
LLM_SEND_TEMPERATURE=false
# Operator estimates, USD per million input/output tokens. Use exact configured IDs.
PRICE_TABLE={}
PRICE_BASIS=operator configured estimates; not billing data
